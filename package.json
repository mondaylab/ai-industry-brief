{
  "name": "the-ai-industry-brief",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "manifest": "node scripts/generate-manifest.mjs",
    "build:app": "node scripts/build-app.mjs",
    "homepage": "node scripts/update-homepage.mjs",
    "radar": "node scripts/generate-radar-snapshot.mjs",
    "papers:sync": "node scripts/sync-papers.mjs",
    "papers:test": "node --test tests/papers/*.test.mjs",
    "build": "npm run manifest && npm run radar && npm run homepage && npm run build:app",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  }
}
